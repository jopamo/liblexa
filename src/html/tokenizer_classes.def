/* LXA_HTML_BYTE_CLASS(name, predicate), ordered by predicate dependencies.
 * Grammar whitespace excludes CR because input preprocessing normalizes it. */
LXA_HTML_BYTE_CLASS(space, c == ' ' || c == '\t' || c == '\n' || c == '\f')
LXA_HTML_BYTE_CLASS(lower, c >= 'a' && c <= 'z')
LXA_HTML_BYTE_CLASS(upper, c >= 'A' && c <= 'Z')
LXA_HTML_BYTE_CLASS(digit, c >= '0' && c <= '9')
LXA_HTML_BYTE_CLASS(alpha, lxa_html_byte_lower(c) || lxa_html_byte_upper(c))
LXA_HTML_BYTE_CLASS(alnum, lxa_html_byte_alpha(c) || lxa_html_byte_digit(c))
LXA_HTML_BYTE_CLASS(hex, lxa_html_byte_digit(c)
                        || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F'))
LXA_HTML_BYTE_CLASS(control, (c < ' ' && !lxa_html_byte_space(c)) || c == 0x7f)
