/* LXA_HTML_CONSUMER_HOOK(name, parameters, ...callback_body). */
LXA_HTML_CONSUMER_HOOK(emit,
    (lxa_html_tokenizer_t *tokenizer, lxa_html_token_t *token),
    lxa_status_t status;
    lxa_limit_reason_t reason = LXA_BUDGET_COUNT;
    status = lxa_budget_charge(tokenizer->budget, LXA_BUDGET_TOKENS, 1, &reason);
    if (status != LXA_OK) {
        return budget_result(tokenizer, status, reason);
    }
    tokenizer->in_callback = true;
    status = LXA_HTML_EMIT_TOKEN(tokenizer, token);
    tokenizer->in_callback = false;
    if (status != LXA_OK) {
        tokenizer->callback_status = status;
        return LXA_HTML_CALLBACK_FAILURE;
    }
    return LXA_HTML_OK;
)
LXA_HTML_CONSUMER_HOOK(filter_value,
    (lxa_html_tokenizer_t *tokenizer),
    if (tokenizer->value_filter == NULL)
        return LXA_HTML_OK;
    if (tokenizer->end_tag) {
        tokenizer->attribute.value_start = SIZE_MAX;
        return LXA_HTML_OK;
    }
    lxa_html_result_t result = charge_work(tokenizer, 1);
    if (result != LXA_HTML_OK)
        return result;
    bool retain = true;
    tokenizer->in_callback = true;
    lxa_status_t status = tokenizer->value_filter(tokenizer->value_filter_context,
        (lxa_span_t){tokenizer->name.data, tokenizer->name.length},
        (lxa_span_t){tokenizer->attribute_bytes.data + tokenizer->attribute.name_start,
                     tokenizer->attribute.name_length}, &retain);
    tokenizer->in_callback = false;
    if (status != LXA_OK) {
        tokenizer->callback_status = status;
        return LXA_HTML_CALLBACK_FAILURE;
    }
    if (!retain)
        tokenizer->attribute.value_start = SIZE_MAX;
    return LXA_HTML_OK;
)
LXA_HTML_CONSUMER_HOOK(emit_error,
    (lxa_html_tokenizer_t *tokenizer, const char *code, size_t offset),
    lxa_status_t status;
    if (tokenizer->control_reported
        && tokenizer->control_offset == offset
        && strcmp(code, "control-character-in-input-stream") == 0) {
        return LXA_HTML_OK;
    }
    if (!LXA_HTML_HAS_DIAGNOSTICS(tokenizer)) {
        return LXA_HTML_OK;
    }
    tokenizer->in_callback = tokenizer->in_error = true;
    status = LXA_HTML_EMIT_DIAGNOSTIC(tokenizer, code, offset);
    tokenizer->in_error = tokenizer->in_callback = false;
    if (status != LXA_OK) {
        tokenizer->callback_status = status;
        return LXA_HTML_CALLBACK_FAILURE;
    }
    return LXA_HTML_OK;
)
